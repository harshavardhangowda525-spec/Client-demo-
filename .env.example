# ---------------------------------------------------------------------------
# Studio platform: environment configuration (copy to .env)
# Secrets live ONLY in server environment variables. Never commit .env.
# ---------------------------------------------------------------------------

# Database (PostgreSQL 14+; the btree_gist extension is created by the migration)
DATABASE_URL=postgresql://demo:demo@localhost:5432/studio_demo
# Separate database used by automated tests (it is wiped and re-seeded)
TEST_DATABASE_URL=postgresql://demo:demo@localhost:5432/studio_test

# API
API_HOST=127.0.0.1
API_PORT=4000
# Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=
# Public URL where the API is reachable (used for auth callback links)
BETTER_AUTH_URL=http://localhost:4000
# Extra comma-separated origins allowed for CORS / CSRF origin checks
CORS_ORIGINS=
# Fastify trustProxy ("loopback" trusts the local Next.js proxies)
TRUST_PROXY=loopback
LOG_LEVEL=info

# Public URLs of the websites and admin panel
SITE_URL_PHOTO=http://localhost:3001
SITE_URL_PODCAST=http://localhost:3002
SITE_URL_EVENTS=http://localhost:3003
SITE_URL_ADMIN=http://localhost:3100
# Where the Next.js servers reach the API (server-side)
API_INTERNAL_URL=http://127.0.0.1:4000

# Payments: demo (simulated, no money moves) | live (Razorpay required) | disabled
PAYMENTS_MODE=demo
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Email (Resend). Without these, emails are stored as previews only.
RESEND_API_KEY=
EMAIL_FROM=

# SMS / WhatsApp (Twilio). Without these, messages are stored as previews only.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=

# Google Maps Embed API key (browser key, restrict by HTTP referrer)
GOOGLE_MAPS_EMBED_API_KEY=

# Show message bodies in the admin notification preview (defaults to true outside production)
NOTIFICATION_PREVIEWS=

# Sample imagery source override (see scripts/fetch-demo-images.mjs)
FLOOT_ASSET_BASE=
